{
  "name": "core-cenf-ts",
  "version": "0.1.0",
  "description": "CENF Core Infrastructure — 17 transversal managers (TypeScript)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^3.24.0",
    "pino": "^9.0.0",
    "ioredis": "^5.5.0",
    "jose": "^6.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "drizzle-orm": "^0.45.2",
    "opossum": "^8.0.0",
    "i18next": "^24.0.0",
    "@nats-io/nats-core": "^3.0.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.4.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.4.0",
    "@types/node": "^22.0.0",
    "supertest": "^7.0.0",
    "@libsql/client": "^0.17.4",
    "@prisma/client": "^6.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "license": "MIT"
}
